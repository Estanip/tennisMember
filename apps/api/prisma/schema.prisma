generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  SUPER_ADMIN
}

enum MemberCondition {
  SOCIO_REGULAR
  ABONADO_TENIS
}

enum MemberDeleteReason {
  FALTA_DE_PAGO
  BAJA_DE_SOCIO
  OTRA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Optional login handle; unique when set (lowercase)
  username     String?  @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Member {
  id        String          @id @default(cuid())
  /// External id from legacy/other DB; unique when set
  memberId  String?         @unique @map("member_id")
  firstName String
  lastName  String
  /// Optional; unique when set
  email     String?         @unique
  /// Argentine DNI: 7–8 digits, unique
  dni       String          @unique
  /// Calendar birth date; age is computed in the API from this field
  birthDate DateTime        @db.Date
  phone     String?
  condition MemberCondition
  /// 0 = No Habilitado, 1 = Habilitado, 2 = Pendiente, 3 = Eliminado
  status    Int
  /// Soft delete timestamp; set together with status=3, cleared on restore
  deletedAt DateTime?
  deletedReason MemberDeleteReason?
  /// Required when deletedReason = OTRA
  deletedReasonDetail String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([deletedAt])
  @@index([condition])
  @@index([status])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([dni])

  @@map("members")
}

enum MemberAuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum MemberAuditSource {
  APP
  GOOGLE_FORM
  IMPORT
}

/// Append-only history of member writes. No FK on memberId so entries outlive member changes.
model MemberAuditLog {
  id            String            @id @default(cuid())
  memberId      String            @map("member_id")
  action        MemberAuditAction
  source        MemberAuditSource
  /// Null when there is no backoffice user (e.g. Google Form webhook)
  actorUserId   String?           @map("actor_user_id")
  actorName     String?           @map("actor_name")
  actorEmail    String?           @map("actor_email")
  actorRole     UserRole?         @map("actor_role")
  /// Full member snapshot before the action; null on CREATE
  before        Json?
  after         Json
  changedFields String[]          @map("changed_fields")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("member_audit_log")
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  method    String?
  statusCode Int?
  userId    String?
  createdAt DateTime @default(now())

  @@map("error_log")
}
