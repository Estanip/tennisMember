generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum MemberCondition {
  SOCIO_REGULAR
  ABONADO_TENIS
}

enum MemberDeleteReason {
  FALTA_DE_PAGO
  BAJA_DE_SOCIO
  OTRA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Member {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  email     String          @unique
  /// Argentine DNI: 7–8 digits, unique
  dni       String          @unique
  /// Calendar birth date; age is computed in the API from this field
  birthDate DateTime        @db.Date
  phone     String?
  condition MemberCondition
  /// 0 = No Habilitado, 1 = Habilitado, 2 = Pendiente, 3 = Eliminado
  status    Int
  /// Soft delete timestamp; set together with status=3, cleared on restore
  deletedAt DateTime?
  deletedReason MemberDeleteReason?
  /// Required when deletedReason = OTRA
  deletedReasonDetail String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([deletedAt])
  @@index([condition])
  @@index([status])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([dni])

  @@map("members")
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  method    String?
  statusCode Int?
  userId    String?
  createdAt DateTime @default(now())

  @@map("error_log")
}
