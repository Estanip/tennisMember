# Copy to .env.development and fill with Supabase / staging values.
# yarn / Prisma: use this file when running against the development DB.

# --- Server ---
PORT=3001
HOST=0.0.0.0

# --- Database (Supabase development) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Auth ---
JWT_SECRET="change-me-development-jwt-secret"

# --- CORS ---
CORS_ORIGIN="https://web-dev.example.com"

# --- Integrations ---
GOOGLE_FORM_WEBHOOK_SECRET="change-me-development-webhook-secret"
