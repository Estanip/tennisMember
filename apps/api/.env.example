# --- Server ---
PORT=3003
HOST=0.0.0.0

# --- Database ---
# Con el docker-compose de este repo: postgresql://socios:socios@localhost:5432/socios?schema=public
# Si usás otro Postgres local (p. ej. user postgres): ajustá user/password/db
DATABASE_URL="postgresql://socios:socios@localhost:5432/socios?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-each-environment"

# --- CORS (must match the web app origin) ---
CORS_ORIGIN="http://localhost:3004"

# --- Integrations ---
GOOGLE_FORM_WEBHOOK_SECRET="change-me-google-form-webhook-secret"

# --- Alertas admin (nuevo socio) ---
ADMIN_ALERT_EMAIL="admin@example.com"

# --- Email (console | resend) ---
EMAIL_PROVIDER="console"
EMAIL_FROM="Socios Alem - Tenis <onboarding@resend.dev>"
RESEND_API_KEY=""
