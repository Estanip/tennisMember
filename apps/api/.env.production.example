# Copy to .env.production and fill with Supabase / production values.
# Never commit real secrets.

# --- Server ---
PORT=3001
HOST=0.0.0.0

# --- Logging ---
LOG_LEVEL="info"
LOG_PRETTY="false"

# --- Database (Supabase production) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Auth ---
# Strong random secret, min 32 chars; placeholders with "change-me" are rejected at boot in production
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="12h"
# ENABLE_SWAGGER="true"  # only if you need /docs in production

# --- CORS ---
CORS_ORIGIN="https://web.example.com"

# --- Integrations ---
GOOGLE_FORM_WEBHOOK_SECRET="change-me-production-webhook-secret"

# --- Alertas / Email ---
ADMIN_ALERT_EMAIL="admin@example.com"
EMAIL_PROVIDER="resend"
EMAIL_FROM="Socios Alem - Tenis <onboarding@resend.dev>"
RESEND_API_KEY=""
